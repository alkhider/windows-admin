<Window x:Class="WinAdmin.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Windows Admin"
        Height="900"
        Width="1480"
        MinHeight="720"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#07080f">
    <Grid>
        <wv2:WebView2 x:Name="PortalView" DefaultBackgroundColor="#07080F" />
        <Border x:Name="LoadingOverlay" Background="#07080f">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Windows Admin"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#f6f1ea"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="StatusText"
                           Text="Starting the local portal…"
                           Margin="0,12,0,0"
                           Foreground="#b9b1c9"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
