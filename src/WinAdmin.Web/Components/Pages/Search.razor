@page "/search"
@inject SearchIndexService SearchSvc
@inject NavigationManager Navigation

<section class="card">
    <div class="card-head">
        <h3>Search this PC</h3>
        <span class="muted">Uses Windows Search index (SystemIndex)</span>
    </div>
    @if (Indexer is not null)
    {
        <div class="banner @(Indexer.QueryOk ? "ok" : "warn")">
            @(Indexer.Available ? Indexer.Status : "Windows Search index is not connected")
            @if (!string.IsNullOrWhiteSpace(Indexer.Service)) { <span> · @Indexer.Service</span> }
            @if (!string.IsNullOrWhiteSpace(Indexer.LastError)) { <div>@Indexer.LastError</div> }
        </div>
    }
    <div class="toolbar">
        <input class="search wide" placeholder="Search files…" @bind="Query" @bind:event="oninput" @onkeydown="OnKey" />
        <button class="btn" @onclick="RunSearch" disabled="@Busy">Search</button>
    </div>
    <div class="chips">
        @foreach (var chip in Chips)
        {
            <button class="btn ghost" @onclick="() => ApplyChip(chip)">@chip.Label</button>
        }
    </div>
</section>

@if (Results.Count > 0)
{
    <section class="card">
        <table>
            <thead><tr><th>Path</th><th>Size</th><th>Modified</th><th></th></tr></thead>
            <tbody>
            @foreach (var item in Results)
            {
                <tr>
                    <td>@item.Path</td>
                    <td>@StorageService.FormatBytes(item.SizeBytes)</td>
                    <td>@(item.Modified?.ToString("g") ?? "—")</td>
                    <td><button class="btn ghost" @onclick="() => OpenFolder(item.Path)">Open folder</button></td>
                </tr>
            }
            </tbody>
        </table>
    </section>
}
else if (Searched)
{
    <p class="muted">No indexed results for this query. The Windows Search catalog only returns files it has already crawled.</p>
}

@code {
    private string Query = "";
    private bool Searched;
    private bool Busy;
    private IndexerStatus? Indexer;
    private List<IndexedFileItem> Results = [];

    private readonly (string Label, string Query, string? Extra)[] Chips =
    [
        ("Documents", "kind:document", null),
        ("> 100 MB", "size:>100MB", null),
        ("This week", "datemodified:this week", null),
        ("Pictures", "kind:picture", null)
    ];

    protected override async Task OnInitializedAsync()
    {
        Indexer = await SearchSvc.GetStatusAsync();
        var q = GetQueryParam("q");
        if (!string.IsNullOrWhiteSpace(q))
        {
            Query = q;
            await RunSearch();
        }
    }

    private string? GetQueryParam(string name)
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && string.Equals(Uri.UnescapeDataString(kv[0]), name, StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(kv[1].Replace("+", " "));
            }
        }

        return null;
    }

    private async Task RunSearch()
    {
        Busy = true;
        Searched = true;
        Results = (await SearchSvc.SearchAsync(Query)).ToList();
        Busy = false;
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await RunSearch();
        }
    }

    private async Task ApplyChip((string Label, string Query, string? Extra) chip)
    {
        Query = chip.Query;
        await RunSearch();
    }

    private void OpenFolder(string path)
    {
        try
        {
            var dir = File.Exists(path) ? Path.GetDirectoryName(path) : path;
            if (!string.IsNullOrWhiteSpace(dir) && Directory.Exists(dir))
            {
                System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo
                {
                    FileName = "explorer.exe",
                    Arguments = $"\"{dir}\"",
                    UseShellExecute = true
                });
            }
        }
        catch
        {
            // ignore
        }
    }
}
